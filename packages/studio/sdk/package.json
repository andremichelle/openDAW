  "license": "AGPL-3.0-or-later",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "One-line installer for the complete OpenDAW Studio tool-chain",
  "repository": {
    "type": "git",
    "url": "https://github.com/andremichelle/opendaw"
  },
  "keywords": [
    "opendaw",
    "audio-dev",
    "daw-sdk",
    "web-audio",
    "music-apps",
