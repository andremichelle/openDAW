{
  "name": "@opendaw/studio-adapters",
  "version": "0.3.1",
  "license": "LGPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "generate-exports": "node generate-exports.mjs",
    "build": "npm run generate-exports && tsc",
    "lint": "eslint \"**/*.ts\"",
    "test": "echo \"No tests to run\"",
    "generate-all-boxes": "npx tsx scripts/generate-all-boxes.ts",
    "pregenerate-all-boxes": "npm run build -w @opendaw/studio-forge-boxes && npm run build -w @opendaw/studio-boxes"
  },
  "dependencies": {
    "@opendaw/lib-box": "^0.0.92",
    "@opendaw/lib-dsp": "^0.0.91",
    "@opendaw/lib-fusion": "^0.0.101",
    "@opendaw/lib-midi": "^0.0.72",
    "@opendaw/lib-runtime": "^0.0.84",
    "@opendaw/lib-std": "^0.0.83",
    "@opendaw/studio-boxes": "^0.0.107",
    "@opendaw/studio-enums": "^0.1.0",
    "soundfont2": "^0.5.0"
  },
  "devDependencies": {
    "@opendaw/eslint-config": "^0.0.28",
    "@opendaw/typescript-config": "^0.0.32"
  },
  "gitHead": "8350421e29d38c9f31e88def06e1f2e6d174acff"
}
