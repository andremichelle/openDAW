{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openDAW",
  "version": "0.0.1",
  "identifier": "org.opendaw.studio",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev --workspace=@opendaw/app-studio",
      "cwd": "../../../.."
    },
    "devUrl": "https://localhost:8080",
    "beforeBuildCommand": {
      "script": "npx turbo run build --filter=@opendaw/app-studio",
      "cwd": "../../../.."
    },
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "openDAW",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "cross-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
